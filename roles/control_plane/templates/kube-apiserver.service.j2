[Unit]
Description=Kubernetes API Server
Documentation=https://github.com/kubernetes/kubernetes

[Service]
ExecStart=/usr/local/bin/kube-apiserver \
  --advertise-address={{ ansible_host }} \
  --allow-privileged=true \
  --apiserver-count={{ groups['master'] | length }} \
  --audit-log-maxage=30 \
  --audit-log-maxbackup=3 \
  --audit-log-maxsize=100 \
  --audit-log-path=/var/log/audit.log \
  --authorization-mode=Node,RBAC \
  --bind-address=0.0.0.0 \
  --client-ca-file={{ kube_ca }} \
  --enable-admission-plugins=NodeRestriction,ServiceAccount \
  --enable-bootstrap-token-auth=true \
  --etcd-cafile={{ kube_ca }} \
  --etcd-certfile={{ cert_dir }}/etcd-server.crt \
  --etcd-keyfile={{ key_dir }}/etcd-server.key \
  --etcd-servers={% for host in groups['master'] %}https://{{ hostvars[host].ansible_host }}:{{ etcd_client_port }}{% if not loop.last %},{% endif %}{% endfor %} \
  --event-ttl=1h \
  --encryption-provider-config={{ enc_dir }}/encryption-config.yaml \
  --kubelet-certificate-authority={{ kube_ca }} \
  --kubelet-client-certificate={{ cert_dir }}/apiserver-kubelet-client.crt \
  --kubelet-client-key={{ key_dir }}/apiserver-kubelet-client.key \
  --kubelet-preferred-address-types={{ kubelet_preferred_address_types | join(',') }} \
  --runtime-config=api/all=true \
  --service-account-key-file={{ cert_dir }}/service-account.crt \
  --service-account-signing-key-file={{ key_dir }}/service-account.key \
  --service-account-issuer=https://{{ loadbalancer_ip }}:{{ apiserver_port }} \
  --service-cluster-ip-range={{ service_cidr }} \
  --service-node-port-range=30000-32767 \
  --tls-cert-file={{ cert_dir }}/kube-apiserver.crt \
  --tls-private-key-file={{ key_dir }}/kube-apiserver.key \
  --v=2
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
