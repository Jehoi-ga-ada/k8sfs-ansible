apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ coredns_name }}
  namespace: {{ coredns_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: system:{{ coredns_name }}
  labels:
    kubernetes.io/bootstrapping: rbac-defaults
rules:
  - apiGroups:
      - ""
    resources:
      - endpoints
      - services
      - pods
      - namespaces
    verbs:
      - list
      - watch
  - apiGroups:
      - discovery.k8s.io
    resources:
      - endpointslices
    verbs:
      - list
      - watch
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: system:{{ coredns_name }}
  annotations:
    rbac.authorization.kubernetes.io/autoupdate: "true"
  labels:
    kubernetes.io/bootstrapping: rbac-defaults
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: system:{{ coredns_name }}
subjects:
  - kind: ServiceAccount
    name: {{ coredns_name }}
    namespace: {{ coredns_namespace }}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ coredns_name }}
  namespace: {{ coredns_namespace }}
data:
  Corefile: |
    .:{{ coredns_dns_port }} {
        errors
        health {
            lameduck 5s
        }
        ready
        kubernetes {{ cluster_domain }} in-addr.arpa ip6.arpa {
            pods insecure
            fallthrough in-addr.arpa ip6.arpa
            ttl 30
        }
        prometheus :{{ coredns_metrics_port }}
        forward . /etc/resolv.conf {
            max_concurrent 1000
        }
        cache 30
        loop
        reload
        loadbalance
    }
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ coredns_name }}
  namespace: {{ coredns_namespace }}
  labels:
    k8s-app: {{ coredns_app_label }}
    kubernetes.io/name: "CoreDNS"
spec:
  replicas: {{ coredns_replicas }}
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 1
  selector:
    matchLabels:
      k8s-app: {{ coredns_app_label }}
  template:
    metadata:
      labels:
        k8s-app: {{ coredns_app_label }}
    spec:
      priorityClassName: system-cluster-critical
      serviceAccountName: {{ coredns_name }}
      dnsPolicy: Default
      nodeSelector:
        kubernetes.io/os: linux
      tolerations:
        - key: CriticalAddonsOnly
          operator: Exists
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
            - weight: 100
              podAffinityTerm:
                topologyKey: kubernetes.io/hostname
                labelSelector:
                  matchLabels:
                    k8s-app: {{ coredns_app_label }}
      containers:
        - name: {{ coredns_name }}
          image: {{ coredns_image }}
          imagePullPolicy: IfNotPresent
          args:
            - -conf
            - /etc/coredns/Corefile
          resources:
            limits:
              memory: 170Mi
            requests:
              cpu: 100m
              memory: 70Mi
          ports:
            - containerPort: {{ coredns_dns_port }}
              name: dns
              protocol: UDP
            - containerPort: {{ coredns_dns_port }}
              name: dns-tcp
              protocol: TCP
            - containerPort: {{ coredns_metrics_port }}
              name: metrics
              protocol: TCP
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              add:
                - NET_BIND_SERVICE
              drop:
                - ALL
          livenessProbe:
            httpGet:
              path: /health
              port: {{ coredns_health_port }}
              scheme: HTTP
            initialDelaySeconds: 60
            timeoutSeconds: 5
            successThreshold: 1
            failureThreshold: 5
          readinessProbe:
            httpGet:
              path: /ready
              port: {{ coredns_ready_port }}
              scheme: HTTP
          volumeMounts:
            - name: config-volume
              mountPath: /etc/coredns
              readOnly: true
      volumes:
        - name: config-volume
          configMap:
            name: {{ coredns_name }}
            items:
              - key: Corefile
                path: Corefile
---
apiVersion: v1
kind: Service
metadata:
  name: {{ coredns_service_name }}
  namespace: {{ coredns_namespace }}
  labels:
    k8s-app: {{ coredns_app_label }}
    kubernetes.io/name: "CoreDNS"
    kubernetes.io/cluster-service: "true"
spec:
  clusterIP: {{ cluster_dns }}
  selector:
    k8s-app: {{ coredns_app_label }}
  ports:
    - name: dns
      port: {{ coredns_dns_port }}
      protocol: UDP
    - name: dns-tcp
      port: {{ coredns_dns_port }}
      protocol: TCP
    - name: metrics
      port: {{ coredns_metrics_port }}
      protocol: TCP
