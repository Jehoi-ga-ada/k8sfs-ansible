apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: {{ kubelet_api_cluster_role }}
  annotations:
    rbac.authorization.kubernetes.io/autoupdate: "true"
  labels:
    kubernetes.io/bootstrapping: rbac-defaults
rules:
  - apiGroups:
      - ""
    resources:
{% for resource in kubelet_api_resources %}
      - {{ resource }}
{% endfor %}
    verbs:
{% for verb in kubelet_api_verbs %}
      - "{{ verb }}"
{% endfor %}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: {{ kubelet_api_binding }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: {{ kubelet_api_cluster_role }}
subjects:
  - apiGroup: rbac.authorization.k8s.io
    kind: User
    name: {{ apiserver_kubelet_user }}
